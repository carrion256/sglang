# env.rvn-w4a16-baseline — container env + launcher parameters for the RVN
# W4A16 baseline profile (packed-NVFP4 checkpoint with a stamped MTP graft, TP1,
# live-verified recipe of docs/rvn-w4a16.md; refreshed 2026-09-25).
#
# run_baseline.sh splits this file in two:
#   * CONTAINER ENV below is passed to `docker run` as `-e KEY=VALUE`, in this
#     order and with nothing added — exactly the five keys the verified recipe
#     passes, so the printed dry-run equals the recipe flag-for-flag.
#   * LAUNCHER PARAMETERS below are read by run_baseline.sh to build CLI flags
#     and are deliberately NOT exported (see LAUNCHER_KEYS in run_baseline.sh;
#     production proves the split — its env says MAX_NUM_SEQS=16 while its CMD
#     passes --max-running-requests=8).
# Source legend: [recipe] = value taken verbatim from the verified recipe;
# [prod] = same key/value as the live workers lilith-vllm/-b
# (docker inspect .Config.Env — the authoritative reference); [plan] = profile
# choice.

# --- CONTAINER ENV (passed as -e, in this order) ----------------------------
# [plan] CLEARED EXPLICITLY. Patch 0034 semantics: env unset/empty = no-op. The
# profile must read the checkpoint's own config.json (no rope_scaling,
# max_position_embeddings 262144, mtp_num_hidden_layers 1 + the rvn_mtp_graft
# stamp, quant_algo W4A16_NVFP4 with `*ple*` excluded and
# ple_embedding_dtype=nvfp4 → packed NVFP4 PLE, docs/rvn-ple-storage-schema.md
# §1). No --json-model-override-args is passed, so nothing overrides that. The
# LIL override file is never referenced.
SGLANG_EMBEDDED_MODEL_OVERRIDES=
# [prod] BF16 dense compute: no online FP8 GEMM conversion. Explicitly kept.
SGLANG_SM120_ONLINE_MXFP8=false
# [recipe] Manifest-backed PACKED NVFP4 PLE host table (WP2 loader, patch
# 0049): 26.8222 GiB pinned host RAM for this checkpoint instead of the ~95 GiB
# the unpacked BF16 lookup would pin. Mandatory alongside
# --ple-offload-embedding; without the offload flag the 320001536x160 table is
# built as a CUDA VocabParallelEmbedding and OOMs at construction.
SGLANG_PLE_PACKED_NVFP4=1
# [recipe][prod] Private draft head in NVFP4 weights / BF16 compute. Set because
# the NEXTN draft is the grafted MTP layer; the launch carries the matching
# --speculative-* flags.
SGLANG_PRIVATE_DRAFT_NVFP4_A16=1
# [recipe][prod] Allocator behavior, unchanged: reduces load-time peak together
# with the serial loader config.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- LAUNCHER PARAMETERS (never passed to the container) --------------------
# [recipe] Served directory: the 2026-09-25 rename of
# /models/rvn-qwen38-ple-nvfp4-mtp, i.e. the packed-NVFP4 checkpoint WITH the
# stamped MTP graft (mtp_graft.json, config mtp_num_hidden_layers=1). Tokenizer
# and chat template are read from this dir — the launch passes no
# --tokenizer-path. The earlier no-MTP candidate /models/rvn-qwen38-ple-nvfp4
# and the 168 GB source copy are retired, so NEXTN against this profile only
# works while the graft stamp is present (patches/0057 still refuses an
# unstamped dir).
MODEL=/models/qwen38-flash-next-uncensored
# [recipe] Model-name isolation: must never collide with the prod served name
# qwen3.8-flash-next (metrics, client routing, cache namespaces).
SERVED_MODEL_NAME=rvn-ple-nvfp4
# [recipe] Port isolation: prod serves 8101 (lilith-vllm) and 8102 (-b).
PORT=8111
# [recipe] TP1 single worker (prod workers are TP1 per container too).
TP_SIZE=1
# [recipe] Drives --context-length. Prod runs 262144 with a YaRN blob to 1M; the
# checkpoint-native maximum is 262144 (no extrapolation needed), so raising this
# needs no rope override. Start at 32768 as the recipe does.
MAX_MODEL_LEN=32768
# [recipe] Drives --max-running-requests; prod runs 8.
MAX_NUM_SEQS=4
# [recipe][prod] Drives --chunked-prefill-size, same value as prod.
MAX_NUM_BATCHED_TOKENS=4096
# [recipe] Drives --mem-fraction-static. 0.90 (not prod's 0.96) is what leaves
# room for the draft + CUDA-graph capture on this checkpoint: load ends at
# 73.36 GB target + 2.95 GB draft with ~9 GB free for pools/graphs.
GPU_MEMORY_UTILIZATION=0.90

# --- GPU selection (NOT in this file) --------------------------------------
# The GPU is pinned by the CDI device flag `--device nvidia.com/gpu=<gpu>` in
# run_baseline.sh. CUDA_VISIBLE_DEVICES / NVIDIA_VISIBLE_DEVICES are NOT
# injected: on this host `--gpus all` + CUDA_VISIBLE_DEVICES does not isolate
# and `--gpus '"device=N"'` is broken (docs/rvn-w4a16.md landmines), and the
# visible GPU inside the container is always cuda:0.

# --- Deliberately absent (prod-only / LIL inherited / superseded) ----------
# TRITON_CACHE_DIR / TORCHINDUCTOR_CACHE_DIR / TILELANG_CACHE_DIR -> the recipe
#   passes none. $HOME is /root and /root/.cache is the baseline-owned bind
#   mount, so the default cache locations already land on it.
# SGLANG_ENABLE_HEALTH_ENDPOINT_GENERATION -> prod-only convenience; not in the
#   recipe.
# SGLANG_PLE_PACKED_FP8_REFERENCE=1 -> legacy LIL FP8-roundtrip PLE reference
#   (docs/rvn-ple-storage-schema.md §1 marks it out of scope for RVN). Never set.
# SGLANG_PLE_SHARED_DIR=/dev/shm/qwen38-ple-sglang -> does not exist in this
#   image at all: patches/0032-shared-ple-host-table.patch is absent from
#   patches/series.production and the runtime tree has zero references to it.
# SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR -> HiCache reuse is OFF; that store
#   is shared by both prod replicas, so it is never mounted.
# SGLANG_IMAGE_MAX_PIXELS=1048576 -> LIL vision passthrough; RVN is text-only
#   (Qwen4ExpForCausalLM, no vision_config). Never set.
