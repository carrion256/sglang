# env.rvn-w4a16-baseline — full container env for the experimental RVN W4A16
# baseline profile (UNCHANGED RVN checkpoint, patched fork, TP1, v1 safety).
# Consumed by run_baseline.sh: every KEY=VALUE line below is passed as `-e`.
# Source legend: [prod] = same key/value as live workers lilith-vllm/-b
# (docker inspect .Config.Env — the authoritative reference); [plan] = v1
# baseline plan setting (deliberate divergence); [launcher] = read by
# run_baseline.sh to build a CLI flag and otherwise inert inside the container
# (production proves this: its env says MAX_NUM_SEQS=16 while the CMD passes
# --max-running-requests=8).

# --- Model / identity -------------------------------------------------------
# [plan] UNCHANGED RVN checkpoint; prod uses /models/qwen38-flash-next.
MODEL=/models/qwen38-flash-next-uncensored
# [plan] Default = the RVN tree itself, i.e. no cross-tree dependency.
# Contingency (observed mid-download on 2026-09-24, `hf download` of 259 files
# still running): the tree then had tokenizer.json, tokenizer_config.json,
# vocab.json and merges.txt MISSING, so --model-path alone failed at tokenizer
# init and the only working value was TOKENIZER_PATH=/models/qwen38-flash-next
# (LIL tree, identical 248320-token vocabulary -> tokenizer bytes unchanged, not
# substituted). The orchestrator verifies tokenizer presence when the download
# completes; use the LIL value only if the finished RVN tree still lacks them.
# Note --chat-template is load-bearing alongside this: it pins the byte-identical
# nix-store template instead of letting sglang auto-discover the tokenizer tree's
# own chat_template.jinja.
TOKENIZER_PATH=/models/qwen38-flash-next-uncensored
# [plan] Model-name isolation: must never collide with prod served name
# qwen3.8-flash-next (metrics, client routing, cache namespaces).
SERVED_MODEL_NAME=rvn-w4a16-baseline
# [plan] Port isolation: prod serves 8101 (lilith-vllm) and 8102 (-b).
PORT=8111
# [launcher] Bind address; the CLI hardcodes --host 0.0.0.0.
HOST=0.0.0.0
# [launcher] TP1 single worker (prod workers are TP1 per container too).
TP_SIZE=1

# --- Limits (v1 conservative) ----------------------------------------------
# [plan] Start short; extend to 262144 only after v1 validation. Drives
# --context-length. Prod runs 262144 with a YaRN blob to 1M. RVN-native
# max_position_embeddings is already 262144 (no extrapolation needed).
MAX_MODEL_LEN=32768
# [launcher] Concurrency 1 initially; prod runs --max-running-requests=8.
MAX_NUM_SEQS=1
# [launcher] [prod] Drives --chunked-prefill-size, same value as prod.
MAX_NUM_BATCHED_TOKENS=4096
# [launcher] [prod] Drives --mem-fraction-static, same value as prod.
GPU_MEMORY_UTILIZATION=0.96

# --- Quantization / compute -------------------------------------------------
# [prod] BF16 dense compute: no online FP8 GEMM conversion. Explicitly kept;
# do not enable for the baseline.
SGLANG_SM120_ONLINE_MXFP8=false

# --- Embedded model overrides ----------------------------------------------
# [plan] CLEARED EXPLICITLY. Patch 0034 semantics: env unset/empty = no-op.
# The RVN baseline must read the RVN checkpoint's own config.json (rope_type
# default, max_position_embeddings 262144, mtp_num_hidden_layers 0, and
# quant_algo W4A16_NVFP4 with `*ple*` excluded → BF16 PLE, per
# docs/rvn-ple-storage-schema.md §1). No --json-model-override-args is passed,
# so nothing overrides that. The LIL override file is never referenced.
SGLANG_EMBEDDED_MODEL_OVERRIDES=

# --- Runtime caches (per-baseline, isolated from prod) ----------------------
# [prod] Same keys/values as prod; files land in the per-GPU cache volume
# /var/cache/sglang/rvn-w4a16-baseline-<gpu>, never prod's namespaces.
TRITON_CACHE_DIR=/root/.cache/triton
TORCHINDUCTOR_CACHE_DIR=/root/.cache/torchinductor
TILELANG_CACHE_DIR=/root/.cache/tilelang
# [prod] Allocator behavior, unchanged.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Serving conveniences ---------------------------------------------------
# [prod] Health endpoint generation, unchanged.
SGLANG_ENABLE_HEALTH_ENDPOINT_GENERATION=1

# --- GPU selection (NOT in this file) --------------------------------------
# CUDA_VISIBLE_DEVICES / NVIDIA_VISIBLE_DEVICES are injected by
# run_baseline.sh from its positional <gpu-index> argument.

# --- Deliberately absent (prod-only / LIL inherited) -----------------------
# SGLANG_PLE_PACKED_FP8_REFERENCE=1  -> legacy LIL FP8-roundtrip PLE reference
#   (docs/rvn-ple-storage-schema.md §1 marks it out of scope for RVN). Never set.
# SGLANG_PLE_PACKED_NVFP4=1          -> packed NVFP4 PLE storage (WP2). Never set.
# SGLANG_PLE_SHARED_DIR=/dev/shm/qwen38-ple-sglang -> does not exist in this
#   image at all: patches/0032-shared-ple-host-table.patch is absent from
#   patches/series.production and the runtime tree has zero references to it.
#   The BF16 PLE table is pinned host RAM, unconditionally ~95 GiB.
# SGLANG_PRIVATE_DRAFT_NVFP4_A16=1   -> private draft-head quant (see
#   deploy/production/environment.json); baseline runs no draft head. Never set.
# SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR -> HiCache reuse is OFF in v1.
# SGLANG_IMAGE_MAX_PIXELS=1048576    -> LIL vision passthrough; RVN is text-only
#   (Qwen4ExpForCausalLM, no vision_config). Removed.
