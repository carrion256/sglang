+                      for ct in self.components_by_type),
+                child.write_through_pending_id, child.load_back_pending_id,
+            ))
+            remaining = remaining[count:]
+            node = child
+            if count < len(child.key):
+                break
+        return node_id, len(key), key.extra_key, key.cache_salt, spans, len(remaining)
