+        def compatible(left: dict, right: dict) -> bool:
+            left_phase, right_phase = left.get("phase"), right.get("phase")
+            if not preserve_qwen_order:
+                return left_phase == right_phase
+            if (
+                left_phase is not None
+                and right_phase is not None
