+"""Scheduler-owned, attention-rank agreement before cache ownership changes."""
+import hashlib
+import logging
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+
+def reduce_values(cache, values, op):
+    data = torch.tensor(values, dtype=torch.int64, device="cpu")
+    # A single-rank cache has no process group (also true for CPU unit fixtures).
+    if (getattr(cache, "tp_world_size", 1) > 1 or
+            getattr(cache, "attn_cp_group", None) is not None or
+            getattr(cache, "attn_tp_group", None) is not None):
+        cache._all_reduce_attn_groups(data, op)
+    return data.tolist()
+
+
+def all_ready(cache, ready):
+    return bool(reduce_values(cache, [int(ready)], torch.distributed.ReduceOp.MIN)[0])
+
+
+def max_values(cache, values):
+    return reduce_values(cache, values, torch.distributed.ReduceOp.MAX)
+
+
+def agree(cache, identity, *, optional=False):
+    """Check exact boundaries; a different frontier cannot label the same state."""
+    digest = hashlib.sha256(repr(identity).encode()).digest()
+    words = [int.from_bytes(digest[i:i + 4], "big") for i in range(0, 32, 4)]
+    lo = reduce_values(cache, words, torch.distributed.ReduceOp.MIN)
+    hi = reduce_values(cache, words, torch.distributed.ReduceOp.MAX)
+    if lo == hi:
+        return True
+    logger.error("HiCache checkpoint failed phase=agreement reason=rank_mismatch action=%s",
+                 "skip_cache" if optional else "stop")
+    if optional:
+        return False
+    raise RuntimeError("HiCache checkpoint rank transaction mismatch")
+
+
+def reserve(cache, identity, resources, recover, *, recoveries=None):
+    """Reserve all resources, undo on any rank's failure, recover once together.
+
+    Each resource is (name, count, alloc, free). Alloc/free must not submit device
+    work or evict tree entries. The caller commits only after successful return.
+    """
+    agree(cache, (identity, [(name, count) for name, count, _, _ in resources]))
+    for attempt in range(2):
+        slots = []
+        failed = False
+        failures = []
+        for name, count, allocate, free in resources:
+            try:
+                value = allocate(count)
+            except MemoryError as error:
+                # Only CPU reservation belongs here; device copies stay outside.
+                logger.error("HiCache checkpoint failed phase=reservation pool=%s reason=%s",
+                             name, type(error).__name__)
+                value = None
+            failures.append(int(value is None))
+            if value is None:
+                failed = True
+            else:
+                slots.append((free, value))
+        if all_ready(cache, not failed):
+            return [value for _, value in slots]
+        for free, value in reversed(slots):
+            free(value)
+        if attempt == 0:
+            logger.debug("HiCache checkpoint recovery phase=reservation action=shared_evict")
+            if recoveries is None:
+                recover()
+            else:
+                for failure, recovery in zip(max_values(cache, failures), recoveries):
+                    if failure:
+                        recovery()
+        else:
+            logger.error("HiCache checkpoint failed phase=reservation reason=exhausted action=skip_cache")
+    return None
+
+
+def transfer(controller, cache, source, extra_pools, node_id, priority, *, to_host):
+    """Reserve a complete hybrid transfer before publishing it to the DMA queue."""
+    from sglang.srt.mem_cache.hicache_storage import PoolName
+    from sglang.srt.managers.cache_controller import CacheOperation
+    from sglang.srt.mem_cache.base_prefix_cache import EvictParams
+
+    resources = []
+    targets = []
+    recoveries = []
+    ready = True
+    extra_pools = extra_pools or []
+    try:
+        full = (controller.mem_pool_host if to_host else
+                getattr(controller.mem_pool_device_allocator, "full_attn_allocator",
+                        controller.mem_pool_device_allocator))
+        resources.append(("kv", len(source), full.alloc, full.free))
+        targets.append(None)
+        recoveries.append(lambda: cache.evict_host(len(source)) if to_host else
+                          cache.evict(EvictParams(num_tokens=len(source))))
+        for pool in extra_pools:
+            entry = controller.mem_pool_host.entry_map[pool.name]
+            if pool.indices_from_pool is not None:
+                if pool.indices_from_pool != PoolName.KV and not any(
+                    p.name == pool.indices_from_pool and p.indices_from_pool is None
+                    for p in extra_pools
+                ):
+                    raise ValueError("missing derived pool source")
+                continue
+            existing = pool.host_indices if to_host else pool.device_indices
+            incoming = pool.device_indices if to_host else pool.host_indices
+            if not isinstance(incoming, torch.Tensor):
+                raise ValueError("missing transfer source")
+            if existing is not None:
+                if existing.numel() != incoming.numel():
+                    raise ValueError("incompatible borrowed destination")
+                continue
+            allocate = entry.host_pool.alloc if to_host else (entry.device_alloc_fn or entry.device_pool.alloc)
+            free = entry.host_pool.free if to_host else (entry.device_free_fn or entry.device_pool.free)
+            evict = entry.host_evict_fn if to_host else entry.device_evict_fn
+            count = len(incoming)
+            resources.append((str(pool.name), count, allocate, free))
+            targets.append(pool)
+            recoveries.append(lambda fn=evict, size=count: fn(size) if fn else None)
+    except (MemoryError, KeyError, ValueError, AttributeError) as error:
+        logger.error("HiCache backup failed phase=preparation reason=%s", type(error).__name__)
+        ready = False
+    if not all_ready(cache, ready):
+        logger.error("HiCache backup failed phase=preparation reason=peer_failure action=skip_backup")
+        return None
+    agree(cache, ("transfer", node_id, to_host, [
+        (str(p.name), str(p.indices_from_pool),
+         None if p.host_indices is None else p.host_indices.numel(),
+         None if p.device_indices is None else p.device_indices.numel()) for p in extra_pools]))
+    slots = reserve(cache, ("transfer", node_id, to_host), resources,
+                    lambda: None, recoveries=recoveries)
+    if slots is None:
+        return None
+    previous = [(pool, pool.host_indices, pool.device_indices) for pool in extra_pools]
+    destination = slots[0]
+    prepared = True
+    try:
+        for pool, indices in zip(targets[1:], slots[1:]):
+            if to_host:
+                pool.host_indices = indices
+            else:
+                pool.device_indices = indices
+        host = destination if to_host else source
+        device = source if to_host else destination
+        for pool in extra_pools:
+            if pool.indices_from_pool is not None:
+                if pool.indices_from_pool == PoolName.KV:
+                    pool.host_indices, pool.device_indices = host, device
+                else:
+                    parent = next(p for p in extra_pools if p.name == pool.indices_from_pool
+                                  and p.indices_from_pool is None)
+                    pool.host_indices, pool.device_indices = parent.host_indices, parent.device_indices
+        for pool in extra_pools:
+            if (not isinstance(pool.host_indices, torch.Tensor)
+                    or not isinstance(pool.device_indices, torch.Tensor)
+                    or pool.host_indices.numel() != pool.device_indices.numel()):
+                raise ValueError("incompatible transfer indices")
+        if not isinstance(destination, torch.Tensor) or destination.numel() != source.numel():
+            raise ValueError("incompatible primary indices")
+    except (MemoryError, ValueError, AttributeError) as error:
+        logger.error("HiCache backup failed phase=indices reason=%s", type(error).__name__)
+        prepared = False
+    if not all_ready(cache, prepared):
+        for (_, _, _, free), indices in reversed(list(zip(resources, slots))):
+            free(indices)
+        for pool, old_host, old_device in previous:
+            pool.host_indices, pool.device_indices = old_host, old_device
+        return None
+    queue = controller.write_queue if to_host else controller.load_queue
+    operation = None
+    queued = False
+    try:
+        operation = CacheOperation(host, device, node_id, priority, pool_transfers=extra_pools or None)
+        queue.append(operation)
+        queued = True
+    except MemoryError:
+        logger.error("HiCache backup failed phase=enqueue reason=MemoryError")
+    if not all_ready(cache, queued):
+        if queued:
+            assert queue[-1] is operation
+            queue.pop()
+        for (_, _, _, free), indices in reversed(list(zip(resources, slots))):
+            free(indices)
+        for pool, old_host, old_device in previous:
+            pool.host_indices, pool.device_indices = old_host, old_device
+        logger.error("HiCache backup failed phase=enqueue reason=peer_failure action=skip_backup")
+        return None
+    # A failure after submission is unsafe to recover by freeing reservations.
+    if to_host:
+        controller.start_writing()
+    return destination
+
+
+class CheckpointPreparationError(Exception):
+    """Optional cache work failed before device submission."""
+
+
+def enqueue(cache, queue, operation):
+    """Keep a CPU worker from consuming a publication before rank agreement."""
+    # Queue.put cannot undo a publication after notifying its consumer.
+    with queue.not_full:
+        queued = False
+        try:
+            queue._put(operation)
+            queued = True
+        except MemoryError:
+            logger.error("HiCache checkpoint failed phase=queue reason=MemoryError")
+        if not all_ready(cache, queued):
+            if queued:
+                assert queue.queue[-1] is operation
+                queue.queue.pop()
+            return False
+        queue.unfinished_tasks += 1
+        queue.not_empty.notify()
+    return True
