--- /dev/null
+++ b/python/sglang/srt/mem_cache/cache_diagnostics.py
@@ -0,0 +1,57 @@
+"""Bounded, request-level explanations for cache work that could not be reused."""
+import logging
+import time
+from collections import Counter
+
+logger = logging.getLogger(__name__)
+
+
+class CacheDiagnostics:
+    PRESSURE = frozenset({'prefetch_capacity', 'component_capacity', 'backup_pending'})
+    QUIET = frozenset({'cold_miss', 'below_threshold'})
+    REASONS = PRESSURE | QUIET | frozenset({'lookup_timeout', 'checkpoint_missing', 'peer_miss', 'restore_incomplete', 'host_capacity'})
+    LARGE_REQUEST = 16384
+    INTERVAL = 60.0
+
+    def __init__(self, rank=0, dp_rank=0, metrics=False, clock=time.monotonic):
+        self.rank = rank
+        self.clock = clock
+        self.counts = Counter()
+        self.suppressed = Counter()
+        self.last_log = {}
+        self.metric = None
+        if metrics:
+            from prometheus_client import Counter as PromCounter
+            self.metric = PromCounter(
+                'sglang:hicache_restore_decisions_total',
+                'HiCache fallback decisions, including quiet cold misses.',
+                ['tp_rank', 'dp_rank', 'reason'],
+            )
+            self.metric_labels = {'tp_rank': str(rank), 'dp_rank': str(dp_rank)}
+
+    def record(self, request_id, reason, requested=0, matched=0, elapsed=0.0, budget=0.0):
+        self.counts[reason] += 1
+        if self.metric is not None:
+            self.metric.labels(**self.metric_labels, reason=reason).inc()
+        if self.rank != 0 or reason in self.QUIET:
+            return
+        now = self.clock()
+        if reason in self.PRESSURE:
+            if requested < self.LARGE_REQUEST:
+                return
+            if now - self.last_log.get(reason, float('-inf')) < self.INTERVAL:
+                self.suppressed[reason] += 1
+                return
+            self.last_log[reason] = now
+        suppressed = self.suppressed.pop(reason, 0)
+        logger.info(
+            'HiCache restore fallback req=%r reason=%s requested=%d matched=%d '
+            'elapsed_s=%.3f budget_s=%.3f suppressed=%d',
+            request_id, reason, requested, matched, elapsed, budget, suppressed,
+        )
+
+
+def record_cache_decision(cache, request_id, reason, **fields):
+    diagnostics = getattr(cache, 'cache_diagnostics', None)
+    if diagnostics is not None:
+        diagnostics.record(request_id, reason, **fields)
