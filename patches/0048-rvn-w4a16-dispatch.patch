+    def _resolve_moe_runner_backend(self, moe_runner_backend):
+        """W4A16_NVFP4 dispatches on the explicit format string to Marlin.
+
+        use_per_token_activation=False alone must not select W4A16 (static
+        W4A4 shares that metadata). Any explicitly selected non-Marlin
+        runner (e.g. the W4A4 FP4 backends) conflicts with W4A16_NVFP4 and
+        raises instead of silently proceeding.
+        """
+        if not getattr(self.quant_config, "is_w4a16_nvfp4", False):
+            return moe_runner_backend
+        if not (moe_runner_backend.is_auto() or moe_runner_backend.is_marlin()):
+            raise ValueError(
+                f"W4A16_NVFP4 quantization requires the Marlin MoE runner, "
+                f"but moe_runner_backend={moe_runner_backend.value!r} selects "
+                "a conflicting W4A4 path. Use --moe-runner-backend marlin "
+                "(or auto)."
+            )
+        # Pin the backend on the instance so create_weights,
+        # process_weights_after_loading and apply all see Marlin via
+        # getattr(self, "_moe_runner_backend", ...), never the global default.
+        self._moe_runner_backend = MoeRunnerBackend.MARLIN
+        return MoeRunnerBackend.MARLIN
+
