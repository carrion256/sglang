+def rvn_ple_storage_for_checkpoint(
+    model_name_or_path: str, hf_folder: Optional[str] = None
+):
+    """Manifest-first packed PLE host tables (``ple_storage.json``, schema v1).
+
+    Recognition is manifest-first and precedes any quant-config decision:
+    the generic linear-quant ``*ple*`` exclusion must not prevent this
+    table loader. Returns the assembled packed host storage when the
+    checkpoint root carries ``ple_storage.json`` — validated fail-closed,
+    copied piecewise, never a BF16 expansion — or ``None`` when it does
+    not, leaving the original (LIL) load path byte-identically untouched.
+    A present but invalid manifest raises; there is no fallback.
+    """
+    from sglang.srt.models.rvn_ple_storage import load_for_checkpoint
+
+    return load_for_checkpoint(
+        hf_folder if hf_folder is not None else model_name_or_path
+    )
+
+
 def _check_index_files_exist(snapshot_dir: str) -> Tuple[bool, Optional[str]]:
     """
     Check if all files listed in safetensors index files actually exist on disk.
