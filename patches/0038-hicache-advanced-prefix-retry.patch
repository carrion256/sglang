--- /dev/null
+++ b/python/sglang/srt/mem_cache/prefetch_retry.py
@@ -0,0 +1,44 @@
+"""One pre-admission disk retry after the compatible local prefix advances."""
+import logging
+
+from sglang.srt.mem_cache.checkpoint_coordination import agree, all_ready
+
+logger = logging.getLogger(__name__)
+
+
+def retry_advanced_prefix(scheduler, req):
+    cache = scheduler.tree_cache
+    # Only the unified write-back path has the coordinated prefetch contract.
+    if not getattr(cache, 'is_write_back', False) or not hasattr(cache, 'tree_core'):
+        return False
+    previous = getattr(req, '_hicache_prefetch_prefix', None)
+    eligible = (
+        previous is not None
+        and not getattr(req, '_hicache_prefetch_retried', False)
+        and not getattr(req, '_hicache_retry_admitted', False)
+        and not req.output_ids
+        and not getattr(req, 'storage_hit_length', 0)
+    )
+    if not all_ready(cache, eligible):
+        return False
+    # A probe must not reserve/donate the request's Mamba COW slot.
+    req.init_next_round_input(cache, cow_mamba=False)
+    current = len(req.prefix_indices) + req.host_hit_length
+    remaining = req._compute_max_prefix_len(len(req.full_untruncated_fill_ids)) - current
+    eligible = current > previous and remaining >= cache.prefetch_threshold
+    if not all_ready(cache, eligible):
+        return False
+    if not agree(cache, ('prefetch_retry', req.rid, previous, current,
+                         req.last_host_node, remaining), optional=True):
+        return False
+    req._hicache_prefetch_retried = True
+    logger.debug('HiCache prefetch retry reason=local_prefix_advanced previous=%d current=%d',
+                 previous, current)
+    diagnostics = getattr(cache, 'cache_diagnostics', None)
+    if diagnostics is not None:
+        # Admission must describe the retry, not retain the superseded miss.
+        diagnostics.pending.pop(req.rid, None)
+    scheduler._prefetch_kvcache(req)
+    # Enqueue may decline for capacity/threshold reasons. One queue pass is safe
+    # in either case; normal completion handling owns all transfer cleanup.
+    return True
