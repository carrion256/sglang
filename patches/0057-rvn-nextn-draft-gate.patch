+def rvn_text_bundled_draft_unsupported(
+    algorithm: Optional[str],
+    config: object,
+    draft_model_path: Optional[str],
+) -> Optional[str]:
+    """Why an RVN text checkpoint cannot host a bundled NEXTN draft layer.
+
+    Returns the reason to reject the launch, or None when it is fine. Three
+    facts, all from the RVN text contract: ``assert_rvn_text_config`` (called by
+    ``Qwen4ExpForCausalLM.__init__`` at models/qwen4_exp.py:3020) requires
+    architectures ``Qwen4ExpForCausalLM`` *and* model_type ``qwen4_exp_text``,
+    the entry class then asserts ``rvn_mtp_count(config) == 0``
+    (models/qwen4_exp.py:3060), and the text loader runs every weight name
+    through ``reject_non_text_weight_name``, which raises on any name containing
+    "mtp". So no bundled draft can be constructed or loaded for this arch -- the
+    shipped candidate index holds 296,238 tensors and none is mtp-named.
+
+    Without this check the launch does not fail cleanly: the draft worker's
+    architecture is never remapped to ``Qwen4ExpForCausalLMMTP`` (that remap in
+    configs/model_config.py:747 is keyed on the multimodal arch alone), so the
+    draft worker constructs the *target* model a second time -- and because
+    patch 0051 propagates ``ple_offload_embedding`` only for
+    ``not is_draft_worker``, the draft's n-gram table is allocated eagerly on the
+    device as a 47.68 GiB ``VocabParallelEmbedding`` and OOMs the load.
+
+    The refusal is not conditioned on the declared MTP count: a text config that
+    declared layers would only reach the bare ``:3060`` assertion instead.
+    ``rvn_mtp_count`` sums the two flat fields only; the candidate also carries
+    an ``mtp`` sub-object (``{"num_hidden_layers": 0, ...}``) that the contract
+    does not read, so do not "fix" the count to include it.
+    """
+    from sglang.srt.models.qwen4_exp_text_adapter import (
+        is_rvn_text_config,
+        rvn_mtp_count,
+    )
+
+    # "EAGLE" is what --speculative-algorithm NEXTN resolves to by now
+    # (_resolve_speculative_algorithm_alias rewrites NEXTN -> EAGLE before the
+    # handler runs; pinned by test_rvn_nextn_draft_gate.py), and no draft path
+    # means the draft layer is expected inside this checkpoint. STANDALONE and an
+    # explicit --speculative-draft-model-path bring their own weights and stay
+    # untouched.
+    if algorithm != "EAGLE" or draft_model_path is not None:
+        return None
+    if not is_rvn_text_config(config):
+        return None
+    return (
+        "--speculative-algorithm NEXTN builds its draft layer from the target "
+        "checkpoint's model.mtp.* weights, but the RVN text contract forbids "
+        "them: Qwen4ExpForCausalLM requires mtp_num_hidden_layers + "
+        f"num_nextn_predict_layers = 0 (this config declares "
+        f"{rvn_mtp_count(config)}) and its loader rejects any weight name "
+        "containing 'mtp', so there is no draft layer to build. Serve without "
+        "speculative decoding, or point --speculative-draft-model-path at an "
+        "external draft checkpoint."
+    )
+
+
