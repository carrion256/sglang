+"""RVN text-only detection, config normalization and weight-name mapping.
+
+Dependency-light on purpose (standard library only) so tests can load this
+module via importlib from a patched scratch tree without the sglang stack.
+Single source of truth for:
+
+* explicit RVN text-model detection (exact architecture AND model_type; never
+  defaults or sub-config presence),
+* flat ``qwen4_exp_text`` config normalization: text-only invariants enforced
+  (zero MTP layers, no vision fields) while sparse-attention/indexer, layer
+  types, hyperconnection count, n-gram hashing/partitioning and rotary fields
+  pass through untouched,
+* checkpoint weight-prefix mapping for the text layout (``model.language_model.``
+  producer prefix -> ``model.`` module form) and PLE n-gram shard recognition,
+  shared by the multimodal and text loaders so the PLE claim path exists once.
+"""
+
+import re
+from typing import Any, Mapping, Optional
+
+# Architecture/model_type names. The tests assert these against the EntryClass
+# lists of models/qwen4_exp.py and models/qwen4_exp_mtp.py (read via AST), so a
+# rename in the model files cannot silently drift away from detection here.
+RVN_TEXT_ARCHITECTURE = "Qwen4ExpForCausalLM"
+RVN_TEXT_MODEL_TYPE = "qwen4_exp_text"
+MULTIMODAL_ARCHITECTURE = "Qwen4ExpForConditionalGeneration"
+MTP_DRAFT_ARCHITECTURE = "Qwen4ExpForCausalLMMTP"
+
+# Flat qwen4_exp_text fields that must survive normalization untouched:
+# sparse-attention/indexer, layer types, hyperconnection count, n-gram
+# hashing/partitioning, rotary parameters and MTP-related flags.
+PRESERVED_CONFIG_FIELDS = (
+    "layer_types",
+    "full_attention_interval",
+    "hc_count",
+    "hc_lowrank",
+    "ngram_size",
+    "heads_per_ngram",
+    "ngram_vocab_size_base",
+    "make_ngram_vocab_size_divisible_by",
+    "split_ngram_parts",
+    "seed",
+    "ple_layer_ids",
+    "ple_embed_dim",
+    "ple_conv_kernel_size",
+    "ple_offload_embedding",
+    "ple_embedding_dtype",
+    "index_share_for_mtp_iteration",
+    "indexer_budget",
+    "indexer_compress_ratio",
+    "indexer_head_dim",
+    "indexer_kv_heads",
+    "indexer_n_heads",
+    "rope_parameters",
+    "rope_scaling",
+    "rope_theta",
+    "partial_rotary_factor",
+    "mtp_use_dedicated_embeddings",
+)
+
+# PLE n-gram table shard tensors. One recognition rule for both loaders (the
+# packed-nvfp4 pair handling and the plain shard copy), never a second copy.
+PLE_SHARD_RE = re.compile(r"\.ngram_embedding\.shard_(\d+)\.(weight_scale|weight)\Z")
+
+_PLE_TABLE_MARK = ".ple.ple_embedding."
+# Buffer names the loader claims under the n-gram table (Qwen4ExpPLELayer).
+_PLE_BUFFER_NAMES = frozenset(
+    {
+        "layer_multipliers",
+        "ngram_heads_offsets",
+        "ngram_heads_vocab_sizes",
+        "weight_scale",
+    }
+)
+_VISUAL_MARK = "visual"
+_MTP_MARK = "mtp"
+
+
+def _field(config: Any, name: str, default: Any = None) -> Any:
+    if isinstance(config, Mapping):
+        return config.get(name, default)
+    return getattr(config, name, default)
+
+
+def config_to_dict(config: Any) -> dict:
+    if isinstance(config, Mapping):
+        return dict(config)
+    to_dict = getattr(config, "to_dict", None)
+    if callable(to_dict):
+        return dict(to_dict())
+    return dict(vars(config))
+
+
+def is_rvn_text_model(architectures: Any, model_type: Any) -> bool:
+    """Explicit RVN text-model detection.
+
+    Both the architecture and the flat model_type must match exactly; a match on
+    only one of them is not RVN and must keep the pre-existing code path.
+    """
+    if isinstance(architectures, str):
+        architectures = [architectures]
+    first = architectures[0] if architectures else None
+    return first == RVN_TEXT_ARCHITECTURE and model_type == RVN_TEXT_MODEL_TYPE
+
+
+def is_rvn_text_config(config: Any) -> bool:
+    return is_rvn_text_model(_field(config, "architectures"), _field(config, "model_type"))
+
+
+def rvn_mtp_count(config: Any) -> int:
+    """MTP depth declared by the config; RVN is defined as zero."""
+    return int(_field(config, "mtp_num_hidden_layers", 0) or 0) + int(
+        _field(config, "num_nextn_predict_layers", 0) or 0
+    )
+
+
+def assert_rvn_text_config(config: Any) -> None:
+    """Checked-wrapper invariants for the RVN text path; raises on violation."""
+    if not is_rvn_text_config(config):
+        raise ValueError(
+            "not an RVN text config: "
+            f"architectures={_field(config, 'architectures')!r} "
+            f"model_type={_field(config, 'model_type')!r}"
+        )
+    if _field(config, "vision_config", None):
+        raise ValueError(
+            "RVN text config must not enable vision fields: "
+            f"vision_config={_field(config, 'vision_config')!r}"
+        )
+    if rvn_mtp_count(config) != 0:
+        raise ValueError(
+            "RVN text config must declare zero MTP layers, got "
+            f"mtp_num_hidden_layers={_field(config, 'mtp_num_hidden_layers', 0)!r} "
+            f"num_nextn_predict_layers={_field(config, 'num_nextn_predict_layers', 0)!r}"
+        )
+
+
+def normalize_text_config(config: Any) -> dict:
+    """Plain-dict view of the config with RVN text-only invariants enforced.
+
+    Non-RVN configs (the LIL multimodal Qwen4ExpConfig and friends) pass through
+    unchanged: the multimodal path must see byte-identical baseline values. RVN
+    flat qwen4_exp_text configs get their text-only invariants checked and their
+    MTP count pinned to 0; every field in PRESERVED_CONFIG_FIELDS keeps its
+    incoming value.
+    """
+    out = config_to_dict(config)
+    if not is_rvn_text_model(out.get("architectures"), out.get("model_type")):
+        return out
+    assert_rvn_text_config(out)
+    out["mtp_num_hidden_layers"] = 0
+    return out
+
+
+def map_text_weight_prefix(name: str) -> str:
+    """Map checkpoint weight prefixes for the text layout.
+
+    The RVN checkpoint is LLaVA-form: text tensors (including PLE under
+    ``model.language_model.layers.*.ple.*``) live under ``model.language_model.``
+    and only ``lm_head`` is unprefixed. Rewrite the producer prefix to sglang's
+    module form and leave every other text name intact. There is deliberately no
+    visual/MTP mapping here; the text-only path rejects those prefixes via
+    reject_non_text_weight_name().
+    """
+    if "language_model" in name:
+        return name.replace("model.language_model.", "model.")
+    return name
+
+
+def is_visual_weight_name(name: str) -> bool:
+    return _VISUAL_MARK in name
+
+
+def is_mtp_weight_name(name: str) -> bool:
+    return _MTP_MARK in name
+
+
+def reject_non_text_weight_name(name: str) -> None:
+    """Text-prefix-only checkpoint rule for the RVN arch: no visual/MTP tensors."""
+    if is_visual_weight_name(name):
+        raise ValueError(f"RVN text checkpoint must not contain visual weights: {name}")
+    if is_mtp_weight_name(name):
+        raise ValueError(f"RVN text checkpoint must not contain MTP weights: {name}")
+
+
+def ple_shard_match(name: str) -> Optional[re.Match]:
+    """Match one PLE n-gram shard tensor; shared claim regex for both loaders."""
+    return PLE_SHARD_RE.search(name)
+
+
+def ple_shard_is_canonical(match: Optional[re.Match]) -> bool:
+    """Loader rule: only canonical ids (``shard_3``, not ``shard_03``) are claimed."""
+    return match is not None and match.group(1) == str(int(match.group(1)))
+
+
+def claim_text_weight_name(name: str) -> str:
+    """Classify one checkpoint tensor exactly as the shared loader claims it.
+
+    Returns ``"ple_shard"`` (canonical PLE n-gram table shard), ``"ple_buffer"``
+    (a ple_embedding table buffer the loader recognizes) or ``"text"`` (a normal
+    parameter, including a malformed shard id the loader leaves unclaimed);
+    raises on visual/MTP names, which cannot exist in an RVN text checkpoint.
+    """
+    reject_non_text_weight_name(name)
+    if ple_shard_is_canonical(ple_shard_match(name)):
+        return "ple_shard"
+    if _PLE_TABLE_MARK in name:
+        buffer_name = name.rsplit(".", 1)[-1]
+        if (
+            buffer_name in _PLE_BUFFER_NAMES
+            or buffer_name.startswith("hashstats_")
+            or buffer_name == "token_lookup"
+        ):
+            return "ple_buffer"
+    return "text"
+
+
+def ple_global_scale_ckpt_key(mod_prefix: str) -> str:
+    """Checkpoint-index key of a packed PLE table's global scale.
+
+    Producer-form lookup (``model.language_model.layers.*``): the RVN checkpoint
+    ships the same LLaVA-style prefixes as LIL, so this remap is shared by both
+    paths and must not be gated per architecture.
+    """
+    return (
+        mod_prefix.replace("model.layers.", "model.language_model.layers.", 1)
+        + ".ngram_embedding.weight_scale_2"
+    )
