+# Where the CUDA runtime is looked up; the battery repoints this at a map file
+# it owns so the handshake can be exercised on a CPU host.
+_PROC_MAPS = "/proc/self/maps"
+_TAG_HEX_LEN = 16
+_HEX_DIGITS = "0123456789abcdef"
+# The rvn_mtp_graft fields patch 0058 freezes; they name the grafted head and
+# the checkpoint it came from.
+_GRAFT_STAMP_KEYS = ("source", "encoder_version", "count")
+
+
+def _mapped_cudart():
+    """The path of the one CUDA runtime this process has mapped, or None.
+
+    /proc/self/maps is the only authority here, and the runtimes it reports are
+    counted by file identity (device and inode from the map line) rather than by
+    path, so one library reached by two names is still one runtime while two
+    builds are two. A pin taken through one runtime and an alias answer from
+    another say nothing about each other, which is what patch 0060 was doing:
+    asking the dynamic linker for "libcudart.so" binds
+    /usr/local/cuda-13.0/targets/x86_64-linux/lib/libcudart.so.13.0.96, not the
+    .../nvidia/cu13/lib/libcudart.so.13 that this process actually has mapped
+    and that its device calls go through. None -- no runtime mapped, or more
+    than one -- means the shared mapping is declined rather than guessed at.
+    """
+    runtimes = {}
+    try:
+        with open(_PROC_MAPS, "r", encoding="utf-8", errors="replace") as maps:
+            for line in maps:
+                fields = line.split()
+                if len(fields) < 6 or not fields[5].startswith("/"):
+                    continue
+                if not fields[5].rsplit("/", 1)[-1].startswith("libcudart.so."):
+                    continue
+                runtimes.setdefault((fields[3], fields[4]), fields[5])
+    except OSError:
+        return None
+    if len(runtimes) != 1:
+        return None
+    return next(iter(runtimes.values()))
+
+
+def _graft_stamp(model_path):
+    """The rvn_mtp_graft stamp of `model_path`, or None.
+
+    Read from the config.json inside the checkpoint directory the loader opens:
+    that copy of the stamp is the one the serving process trusts -- patch 0058
+    gates a grafted draft on exactly these fields -- and it carries the source
+    checkpoint and encoder version that tell one checkpoint from every other.
+    """
+    import json
+    import os
+
+    try:
+        with open(os.path.join(model_path, "config.json"), "rb") as config:
+            config = json.load(config)
+    except Exception:
+        return None
+    stamp = config.get("rvn_mtp_graft") if isinstance(config, dict) else None
+    if not isinstance(stamp, dict):
+        return None
+    return {key: stamp.get(key) for key in _GRAFT_STAMP_KEYS}
+
+
+def _checkpoint_tag():
+    """First 16 hex chars of sha256 over this checkpoint's identity, or None.
+
+    The identity is the served model path plus that checkpoint's grafted-head
+    stamp, both taken the way the loader takes them: the model path is the one
+    sglang hands to the weight loader, the stamp is the config.json field
+    patch 0058 gates on. Every replica of one checkpoint derives the same tag
+    and so keeps converging on one shared file; a different checkpoint derives
+    a different tag, so it gets its own file or the private path. An identity
+    that is not known yet -- no serving config, no readable config, an
+    unstamped checkpoint -- returns None and the shared path is refused, because
+    a table with no identity is exactly what a foreign loader looks for.
+    """
+    import hashlib
+
+    try:
+        from sglang.srt.server_args import get_global_server_args
+
+        model_path = get_global_server_args().model_path
+    except Exception:
+        return None
+    if not model_path:
+        return None
+    stamp = _graft_stamp(model_path)
+    if not stamp or any(stamp.get(key) in (None, "") for key in _GRAFT_STAMP_KEYS):
+        # The served checkpoint's own stamp is what makes this an identity that
+        # belongs to a checkpoint rather than to a path. Hashing a path with
+        # absent stamp fields would yield a tag that looks like an identity and
+        # is not one: it would survive the checkpoint being swapped underneath,
+        # which is the collision this gate exists to close. Decline instead and
+        # let the private pinned table carry the load.
+        return None
+    identity = "\n".join((
+        "rvn-ple-shared-identity-v1",
+        f"model={model_path}",
+        f"graft_source={stamp['source']}",
+        f"graft_encoder_version={stamp['encoder_version']}",
+        f"graft_count={stamp['count']}"))
+    return hashlib.sha256(identity.encode("utf-8")).hexdigest()[:_TAG_HEX_LEN]
+
+
+def _table_tag(name):
+    """The checkpoint tag a shared-table filename carries, or None.
+
+    The names this shipped with before patch 0061 carry no tag, and neither
+    does anything else that is not a tagged table name; None means there is no
+    identity to honour, which is as much a claim on the shared dir as a
+    foreign tag is.
+    """
+    if not name.endswith(".bin") or "-" not in name:
+        return None
+    tag = name[name.rfind("-") + 1:-len(".bin")]
+    if len(tag) != _TAG_HEX_LEN or any(c not in _HEX_DIGITS for c in tag):
+        return None
+    return tag
+
+
+def _foreign_claim(shared_dir, tag):
+    """A shared-dir entry this checkpoint must not share with, or None.
+
+    Any table whose tag is not ours counts, the untagged pre-0061 names
+    included: their implied tag is unknown, and unknown is precisely what a
+    cross-checkpoint rewrite thrives on. The profile wipes the shared dir
+    (`shmCleanupGlobs`) before every replica launches, so a boot that still
+    finds an old table there is a boot that has not been cleaned; refusing the
+    shared path then costs pinned RAM and nothing else, because the foreign
+    file is left exactly as found -- never opened, never truncated, never
+    unlinked from here.
+    """
+    import os
+
+    try:
+        entries = sorted(os.listdir(shared_dir))
+    except OSError:
+        return None
+    for name in entries:
+        if name.endswith(".bin") and _table_tag(name) != tag:
+            return name
+    return None
+
 
