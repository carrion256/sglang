+def _rvn_grafted_mtp_draft(config) -> bool:
+    """Whether this draft config carries the graft tool's stamp (patch 0058).
+
+    This is the stamp half of ``rvn_mtp_graft_active`` only: the count rule
+    is the stamp's own ``count == 1`` field, deliberately NOT the adapter's
+    ``rvn_mtp_count`` depth, because by the time a draft model is
+    constructed the ModelConfig remap has added ``num_nextn_predict_layers
+    = 1`` next to the kept ``mtp_num_hidden_layers = 1`` on the same flat
+    object (get_hf_text_config is a no-op for pure-text configs), so the
+    declared depth is legitimately 2 here and only the tool's frozen
+    encoder_version plus its self-declared count still distinguish a graft.
+    The import is deferred: srt.models owns the adapter, which owns the
+    frozen literal.
+    """
+    if config is None:
+        return False
+    stamp = (
+        config.get("rvn_mtp_graft")
+        if isinstance(config, dict)
+        else getattr(config, "rvn_mtp_graft", None)
+    )
+    if stamp is None:
+        return False
+    from sglang.srt.models.qwen4_exp_text_adapter import (
+        RVN_MTP_GRAFT_ENCODER_VERSION,
+    )
+
+    def _stamp_field(name, default=None):
+        return (
+            stamp.get(name, default)
+            if isinstance(stamp, dict)
+            else getattr(stamp, name, default)
+        )
+
+    if _stamp_field("encoder_version") != RVN_MTP_GRAFT_ENCODER_VERSION:
+        return False
+    return int(_stamp_field("count", 0) or 0) == 1
+
+
+def _mtp_quant_config(quant_config, config=None):
     """The quantization the MTP module itself is built with.
 
     The MTP module often ships unquantized even though the target checkpoint is
     quantized; the loader's fusion gate has to see the same normalization the
     constructor applies, or it would answer for the target's quantization.
+
+    ``config`` (patch 0059) is the draft's own HF config, and a grafted RVN
+    text checkpoint is the one case it decides: the graft tool copied another
+    checkpoint's NVFP4 ``mtp.*`` tensors byte for byte (that is what the
+    rvn-mtp-graft-r1 stamp attests), so the draft must keep the target's
+    quantization -- which is exactly what ``--speculative-draft-model-
+    quantization`` hands over for a grafted launch. Without this the branch
+    below answers "BF16 MTP" for the graft too (the RVN W4A16 config is
+    uniform, names no mtp.* layer, and "NVFP4" is a substring of
+    "W4A16_NVFP4"), the draft's FusedMoE allocates BF16 w13 of [2*I, K], and
+    loading a packed [I, K/2] gate_proj dies in fused_moe_triton/layer.py's
+    _load_w13 with ``size of tensor a (2560) must match ... (1280)``.
     """
+    # Grafted RVN text draft head: mtp.* is packed, keep the quantization.
+    if quant_config is not None and _rvn_grafted_mtp_draft(config):
+        return quant_config
     # Most serialized Qwen3.5 ModelOpt checkpoints keep MTP in BF16,
     # but mixed checkpoints may explicitly quantize mtp.* (e.g. LIL NVFP4).
     # Preserve the mixed config in that case so packed weights get packed
